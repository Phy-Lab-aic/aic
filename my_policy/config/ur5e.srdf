<?xml version="1.0" encoding="UTF-8"?>
<!--
  UR5e SRDF for MoveIt2 PILZ planner.

  Robot name must match the name attribute in ur_gz.urdf.xacro.
  Default: <xacro:arg name="name" default="ur"/> → robot name = "ur"

  Planning group "manipulator":
    chain base_link → gripper/tcp
    Covers all 6 revolute UR5e joints plus the fixed joint chain
    to gripper/tcp (via tool0 → cam_mount → ati → gripper → tcp).
    KDL handles fixed joints transparently.
-->
<robot name="ur">

  <!-- Planning group: base_link → gripper/tcp -->
  <group name="manipulator">
    <chain base_link="base_link" tip_link="gripper/tcp" />
  </group>

  <!-- End effector -->
  <end_effector name="gripper_eef"
                parent_link="tool0"
                group="manipulator" />

  <!-- Virtual joint: robot is fixed to the world -->
  <virtual_joint name="virtual_joint"
                 type="fixed"
                 parent_frame="world"
                 child_link="base_link" />

  <!-- Disable self-collisions: UR5e adjacent links -->
  <disable_collisions link1="base_link_inertia" link2="shoulder_link"     reason="Adjacent" />
  <disable_collisions link1="shoulder_link"     link2="upper_arm_link"    reason="Adjacent" />
  <disable_collisions link1="upper_arm_link"    link2="forearm_link"      reason="Adjacent" />
  <disable_collisions link1="forearm_link"      link2="wrist_1_link"      reason="Adjacent" />
  <disable_collisions link1="wrist_1_link"      link2="wrist_2_link"      reason="Adjacent" />
  <disable_collisions link1="wrist_2_link"      link2="wrist_3_link"      reason="Adjacent" />

  <!-- Short-range links that can never collide geometrically -->
  <disable_collisions link1="base_link_inertia" link2="upper_arm_link"    reason="Never" />
  <disable_collisions link1="forearm_link"      link2="wrist_2_link"      reason="Never" />
  <disable_collisions link1="forearm_link"      link2="wrist_3_link"      reason="Never" />
  <disable_collisions link1="wrist_1_link"      link2="wrist_3_link"      reason="Never" />

  <!-- Gripper + sensor chain: all fixed joints, cannot collide with each other -->
  <disable_collisions link1="wrist_3_link"                link2="flange"                       reason="Adjacent" />
  <disable_collisions link1="flange"                       link2="tool0"                        reason="Adjacent" />
  <disable_collisions link1="tool0"                        link2="cam_mount/cam_mount_link"      reason="Adjacent" />
  <disable_collisions link1="cam_mount/cam_mount_link"     link2="ati/base_link"                reason="Adjacent" />
  <disable_collisions link1="ati/base_link"                link2="ati/tool_link"                reason="Adjacent" />
  <disable_collisions link1="ati/tool_link"                link2="gripper/hande_base_link"      reason="Adjacent" />

  <!-- Tool chain to wrist_3: fixed chain, cannot collide -->
  <disable_collisions link1="ati/base_link"            link2="wrist_3_link"  reason="Never" />
  <disable_collisions link1="ati/tool_link"            link2="wrist_3_link"  reason="Never" />
  <disable_collisions link1="cam_mount/cam_mount_link" link2="wrist_3_link"  reason="Never" />
  <disable_collisions link1="cam_mount/cam_mount_link" link2="wrist_2_link"  reason="Never" />

  <!-- Gripper base to upper arm/wrist: geometrically impossible -->
  <disable_collisions link1="gripper/hande_base_link" link2="wrist_3_link"  reason="Never" />
  <disable_collisions link1="gripper/hande_base_link" link2="wrist_2_link"  reason="Never" />

  <!-- Gripper finger links -->
  <disable_collisions link1="gripper/hande_base_link"     link2="gripper/hande_finger_link_l"  reason="Adjacent" />
  <disable_collisions link1="gripper/hande_base_link"     link2="gripper/hande_finger_link_r"  reason="Adjacent" />
  <disable_collisions link1="gripper/hande_finger_link_l" link2="gripper/hande_finger_link_r"  reason="Never" />

  <!-- ATI sensor to gripper base: fixed, always touching -->
  <disable_collisions link1="ati/base_link" link2="gripper/hande_base_link" reason="Adjacent" />

  <!-- Camera mount to cameras: fixed joints -->
  <disable_collisions link1="cam_mount/cam_mount_link" link2="center_camera/camera_link" reason="Adjacent" />
  <disable_collisions link1="cam_mount/cam_mount_link" link2="left_camera/camera_link"   reason="Adjacent" />
  <disable_collisions link1="cam_mount/cam_mount_link" link2="right_camera/camera_link"  reason="Adjacent" />

</robot>
